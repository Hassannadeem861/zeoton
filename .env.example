# Copy to .env.local and fill in. Never commit .env.local.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/zeoton?retryWrites=true&w=majority

# Public site URL (no trailing slash). Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production (Vercel): NEXT_PUBLIC_SITE_URL=https://www.zeoton.online

# Session token hashing pepper: long random string (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# Initial admin account created by `npm run seed` (existing admin passwords are never overwritten).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=ZEOTON Admin

# Cloudinary (product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=zeoton/products
